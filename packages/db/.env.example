# Supabase → Connect → "Direct connection" (또는 Session pooler) 문자열. 비밀번호는 프로젝트 생성 시 정한 DB 비밀번호.
# 예: postgresql://postgres.[ref]:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# 자동 수집 (pnpm db:collect) — 네이버 개발자센터 애플리케이션 (검색 API), 유튜브 Data API v3
# 네이버 검색 — 네이버클라우드 NAVER API HUB (콘솔 > NAVER API HUB > Application > 인증 정보). 2026-07부터 개발자센터 신규 발급 불가
NCP_API_KEY_ID=
NCP_API_KEY=
# (구) 개발자센터 키 — 이미 있는 경우만, 2027-06-30까지
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# 공공데이터포털 전통주정보(한국농수산식품유통공사) — datago 스크립트. 일반 인증키(Decoding) + 활용신청 상세의 End Point
DATA_GO_KR_KEY=
DATA_GO_KR_TRADLIQ_URL=https://api.odcloud.kr/api/15048755/v1/uddi:f60051e9-9730-4686-b4df-a45a84e8a849
