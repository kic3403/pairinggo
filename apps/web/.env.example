# Supabase (Project Settings → API). 비워 두면 API는 번들 내장 데이터(정적)로 응답하고 이벤트는 저장하지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 크론(/api/cron/popular) 보호용 — 아무 긴 문자열. Vercel Cron은 Authorization: Bearer <CRON_SECRET> 로 호출
CRON_SECRET=
# 미니앱 origin 화이트리스트(쉼표 구분). 비우면 모든 origin 허용(공개 GET·이벤트 수집만 있으므로 허용)
ALLOWED_ORIGINS=
# 카카오 디벨로퍼스 → 앱 키 → REST API 키 (서버 전용, 로컬 API)
KAKAO_REST_KEY=
# 구글 장소 평점(Places API (New), 서버 전용)
GOOGLE_PLACES_KEY=
# 어드민 식당 정보의 "메뉴판 사진으로 자동 입력"(Claude API, 서버 전용). console.anthropic.com → API Keys. 없으면 그 기능만 꺼진다
ANTHROPIC_API_KEY=
# 운영 어드민(/admin) 로그인 비밀번호 · 쿠키 서명 비밀(선택, 없으면 비밀번호로 서명)
ADMIN_PASSWORD=
ADMIN_SECRET=

# 간편로그인 (Auth.js) — openssl rand -base64 32 또는 npx auth secret
AUTH_SECRET=
# 카카오: developers.kakao.com > 내 애플리케이션 > 카카오 로그인 (REST API 키 / 보안 Client Secret)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 네이버: developers.naver.com > 애플리케이션 등록 > 네이버 로그인
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
# 구글: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 공개 도메인 (사이트맵·canonical·OAuth 콜백)
SITE_URL=

# "많이 찾는 전통주" 일일 집계(/api/cron/mentions, 00:00 KST) — 채널별 최근 30일 언급량
# 네이버 블로그: 네이버클라우드 NAVER API HUB 인증 정보 (packages/db/.env와 같은 값)
NCP_API_KEY_ID=
NCP_API_KEY=
# 유튜브 Data API v3 키 (검색 1회 = 할당량 100, 일 10,000 → 하루 절반씩 갱신)
YOUTUBE_API_KEY=
# 구글 Programmable Search: console.cloud.google.com > Custom Search API 키 · programmablesearchengine.google.com > 검색엔진 ID(cx)
# 검색엔진은 블로그 도메인(tistory.com, brunch.co.kr, velog.io, blogspot.com, medium.com)으로 제한. 무료 100회/일
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# 카카오 JS 키(도메인 제한 공개 키) — 카톡 공유 버튼. 없으면 기기 공유창·복사만
NEXT_PUBLIC_KAKAO_JS_KEY=
