# Supabase (Project Settings → API). 비워 두면 API는 번들 내장 데이터(정적)로 응답하고 이벤트는 저장하지 않는다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 크론(/api/cron/popular) 보호용 — 아무 긴 문자열. Vercel Cron은 Authorization: Bearer <CRON_SECRET> 로 호출
CRON_SECRET=
# 미니앱 origin 화이트리스트(쉼표 구분). 비우면 모든 origin 허용(공개 GET·이벤트 수집만 있으므로 허용)
ALLOWED_ORIGINS=
# 카카오 디벨로퍼스 → 앱 키 → REST API 키 (서버 전용, 로컬 API)
KAKAO_REST_KEY=
# 운영 어드민(/admin) 로그인 비밀번호 · 쿠키 서명 비밀(선택, 없으면 비밀번호로 서명)
ADMIN_PASSWORD=
ADMIN_SECRET=

# 간편로그인 (Auth.js) — openssl rand -base64 32 또는 npx auth secret
AUTH_SECRET=
# 카카오: developers.kakao.com > 내 애플리케이션 > 카카오 로그인 (REST API 키 / 보안 Client Secret)
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 네이버: developers.naver.com > 애플리케이션 등록 > 네이버 로그인
AUTH_NAVER_ID=
AUTH_NAVER_SECRET=
# 구글: console.cloud.google.com > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 공개 도메인 (사이트맵·canonical·OAuth 콜백)
SITE_URL=
