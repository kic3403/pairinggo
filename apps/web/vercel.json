{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "crons": [
    {
      "path": "/api/cron/popular",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/mentions",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/reservations",
      "schedule": "0 23 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 0 * * 1"
    },
    {
      "path": "/api/cron/evidence",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/ops-report",
      "schedule": "30 0 * * 1"
    },
    {
      "path": "/api/cron/weather",
      "schedule": "30 22 * * *"
    }
  ],
  "regions": [
    "icn1"
  ]
}
